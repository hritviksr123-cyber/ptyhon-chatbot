REFLECTIONS = {
    "i am": "you are",
    "i": "you",
    "me": "you",
    "my": "your",
    "myself": "yourself",
    "you are": "I am",
    "your": "my",
    "yours": "mine",
    "you": "me",
}


def reflect(fragment):
    words = fragment.lower().split()
    for i, word in enumerate(words):
        if word in REFLECTIONS:  # Fixed variable name to uppercase REFLECTIONS
            words[i] = REFLECTIONS[word]
    return " ".join(words)


def bot_respond(user_message):
    for pattern, responses in botRules:
        match = re.match(pattern, user_message, re.IGNORECASE)
        if match:
            chosen_response = random.choice(responses)

            # Fixed typos: 'chosen respone' -> 'chosen_response'
            if "{0}" in chosen_response and match.groups():
                # Safely get the first matched group that isn't None
                fragment = next((g for g in match.groups() if g is not None), "")
                reflected_fragment = reflect(fragment)
                return chosen_response.format(reflected_fragment)

            return chosen_response


print("Bot: Hello whats on your mind today?")
while True:  # Fixed 'true' to 'True'
    user_input = input("You: ").strip()
    if user_input.lower() in ["bye", "quit", "exit"]:
        print("Bot: Thanks for talking today, Goodbye!")
        break

    time.sleep(0.5)
    bot_reply = bot_respond(user_input)
    print(f"Bot: {bot_reply}")
